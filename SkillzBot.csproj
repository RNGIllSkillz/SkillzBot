<Project Sdk="Microsoft.NET.Sdk.web">

  
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net6.0</TargetFramework>
    <RuntimeIdentifier>linux-x64</RuntimeIdentifier>
    <PublishSingleFile>true</PublishSingleFile>
	<SuppressTfmSupportBuildWarnings>true</SuppressTfmSupportBuildWarnings>
	<AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
	<GenerateBindingRedirectsOutputType>true</GenerateBindingRedirectsOutputType>
  </PropertyGroup>

  
  <ItemGroup>
    <None Remove="IllSkillzBot\IllChatMessageHandler.csBe" />
    <None Remove="Utils\StringUtil.csBe" />
  </ItemGroup>

  
  <ItemGroup>
    <None Include="IllSkillzBot\IllCommandsNest\IllCommands.cs" />
    <None Include="IllSkillzBot\IllCommandsNest\IllCommands_WIP.cs" />
  </ItemGroup>
  
  <ItemGroup>
    <PackageReference Include="Camille.RiotGames" Version="3.0.0-nightly-2024-04-20-4d8da4ce47" />
    <PackageReference Include="Discord.Net" Version="3.17.4" />
    <PackageReference Include="eladaus.urldetector" Version="1.3.0" />
    <PackageReference Include="F23.StringSimilarity" Version="6.0.0" />
    <PackageReference Include="Google.Apis.YouTube.v3" Version="1.69.0.3764" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="9.0.6" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="9.0.6" />
    <PackageReference Include="MySql.Data" Version="9.3.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="OpenAI" Version="2.1.0" />
    <PackageReference Include="Quartz" Version="3.14.0" />
    <PackageReference Include="TwitchLib" Version="3.5.3" />
    <PackageReference Include="TwitchLib.Api" Version="3.9.0" />
    <PackageReference Include="TwitchLib.Api.Core" Version="3.9.0" />
    <PackageReference Include="TwitchLib.Api.Core.Enums" Version="3.9.0" />
    <PackageReference Include="TwitchLib.Api.Core.Interfaces" Version="3.9.0" />
    <PackageReference Include="TwitchLib.Api.Core.Models" Version="3.9.0" />
    <PackageReference Include="TwitchLib.Api.Helix" Version="3.9.0" />
    <PackageReference Include="TwitchLib.Client" Version="3.4.0" />
    <PackageReference Include="TwitchLib.EventSub.Core" Version="2.6.0" />
    <PackageReference Include="TwitchLib.EventSub.Websockets" Version="0.6.0" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="STRINGS\STRINGS.ko.resx">
      <LastGenOutput>STRINGS.ko.Designer.cs</LastGenOutput>
      <Generator>ResXFileCodeGenerator</Generator>
    </EmbeddedResource>
    <EmbeddedResource Update="STRINGS\STRINGS.ja.resx">
      <LastGenOutput>STRINGS - Copy.Designer.cs</LastGenOutput>
      <Generator>ResXFileCodeGenerator</Generator>
    </EmbeddedResource>
    <EmbeddedResource Update="STRINGS\STRINGS.fr.resx">
      <LastGenOutput>STRINGS - Copy.ru.Designer.cs</LastGenOutput>
      <Generator>ResXFileCodeGenerator</Generator>
    </EmbeddedResource>
    <EmbeddedResource Update="STRINGS\STRINGS.resx">
      <LastGenOutput>STRINGS.Designer.cs</LastGenOutput>
      <Generator>ResXFileCodeGenerator</Generator>
    </EmbeddedResource>
    <EmbeddedResource Update="STRINGS\STRINGS.ru.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>STRINGS.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <Compile Update="STRINGS\STRINGS.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>STRINGS.resx</DependentUpon>
    </Compile>
  </ItemGroup>

</Project>
