        static StringUtil()
        {
            rankValues = new Dictionary<string, double>
            {
                { "challenger i", 31 }, { "grandmaster i", 30 }, { "master i", 29 }, { "diamond i", 28 },
                { "diamond ii", 27 }, { "diamond iii", 26 }, { "diamond iv", 25 },
