                { "iron i", 4 }, { "iron ii", 3 }, { "iron iii", 2 }, { "iron iv", 1 },
                { "unranked", 0 }
            };

            // 1. Initialize map where every char maps to itself by default
            for (int i = 0; i < _map.Length; i++)            
                _map[i] = (char)i;
            // 2. Load from the Source of Truth for Normilizer
            foreach (var entry in Mappings)
            {
                char targetBase = entry.Key;
                foreach (char variant in entry.Value)
                {
                    // Map every strange variant back to the simple key (e.g. '@' -> 'a')
                    _map[variant] = targetBase;
                }
            }
            // 3. Load from the Source of Truth for Obfuscator
            foreach (var entry in Mappings)
            {
                // Map the simple key to the array of strange variants (e.g. 'a' -> ['@', 'Ä'...])
                _obfuscationMap[entry.Key] = entry.Value;
            }

