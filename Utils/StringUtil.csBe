        private const string urlPattern = @"https?:\/\/clips\.twitch\.tv\/[A-Za-z0-9_-]+";
        private const string YouTubeIDPattern = @"(?<=v=|\/)([a-zA-Z0-9_-]{11})(?=\&|\?|$)";
